{
  "name": "blink",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n web,worker \"next dev\" \"tsx watch scripts/worker.ts\"",
    "build": "next build",
    "start": "next start",
    "worker": "tsx scripts/worker.ts",
    "demo": "BLINK_LLM_MODE=replay pnpm build && BLINK_LLM_MODE=replay concurrently -n web,worker \"next start\" \"tsx scripts/worker.ts\"",
    "db:generate": "drizzle-kit generate",
    "db:reset": "rm -f data/blink.db data/blink.db-wal data/blink.db-shm && mkdir -p data && drizzle-kit migrate && tsx scripts/seed.ts",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "eval": "tsx scripts/eval.ts",
    "record": "BLINK_LLM_MODE=record tsx scripts/record-demo.ts",
    "demo:check": "BLINK_LLM_MODE=replay tsx scripts/record-demo.ts",
    "audit:verify": "tsx scripts/verify-audit.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.7.0",
    "@fontsource-variable/inter": "5.3.0",
    "@xyflow/react": "12.12.1",
    "better-sqlite3": "13.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "0.5.2",
    "drizzle-orm": "0.45.4",
    "lucide-react": "^1.71.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/turbopack": "4.3.5",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "10.0.7",
    "drizzle-kit": "0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "5.1.0"
  },
  "packageManager": "pnpm@10.33.2"
}
