ANTHROPIC_API_KEY=            # or rely on `ant auth login` profile
BLINK_LLM_MODE=record         # live | record | replay
BLINK_MODEL=claude-opus-5-5
BLINK_DB_PATH=./data/blink.db
DEEPGRAM_API_KEY=             # server-only; needs the Member role to mint short-lived tokens
BLINK_LIVE_MODEL=claude-haiku-5-5
BLINK_AUTH_MODE=switcher      # switcher | password. Anything but "switcher" means password sign-in.
BLINK_ALLOW_SWITCHER=         # 1 lets a production build (`next start`) use the switcher: the demo and e2e only, never a deployment
BLINK_SEED_PASSWORDS=         # JSON keyed by demo user id, e.g. {"user_priya":"..."}; read by the seed, never logged
