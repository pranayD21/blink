{
  "label": "Hand-written fallback for blink-demo-policy-v1 (compile_source = manual)",
  "note": "Used only if live AI compilation is unavailable. Goes through the same validator, scenarios, and owner approval as an AI compile, and is labeled \"manual\" in the UI.",
  "policy": "blink-demo-policy-v1.md",
  "inventory": {
    "clauses": [
      {
        "clause_id": "C1",
        "paragraph": "P1",
        "verbatim": "This policy applies to all calls between Blink Demo Capital investment personnel and external experts arranged through an approved expert network.",
        "kind": "definition",
        "plain_meaning": "Scope: the policy covers every call between the firm's investment staff and experts arranged through an approved expert network.",
        "cross_refs": [],
        "ambiguity": null
      },
      {
        "clause_id": "C2",
        "paragraph": "P2",
        "verbatim": "Compliance must review any statement by an expert that describes company-specific operating results, such as orders, bookings, revenue, margins, pricing, inventory, or headcount, for a covered issuer, where the expert attributes the information to internal company systems, internal documents, or conversations with current employees.",
        "kind": "duty",
        "plain_meaning": "Compliance must review an expert's statement of company-specific operating results for a covered issuer when the expert attributes it to internal systems, internal documents, or current employees.",
        "cross_refs": [
          "P6",
          "P7"
        ],
        "ambiguity": null
      },
      {
        "clause_id": "C3",
        "paragraph": "P3",
        "verbatim": "Compliance must review, and escalate to a senior compliance officer, any statement indicating that an expert accessed a former employer's internal systems or documents after their employment ended.",
        "kind": "escalation",
        "plain_meaning": "Any statement showing the expert accessed a former employer's internal systems or documents after leaving must be reviewed and escalated to a senior compliance officer.",
        "cross_refs": [
          "P7"
        ],
        "ambiguity": null
      },
      {
        "clause_id": "C4",
        "paragraph": "P4",
        "verbatim": "Compliance must review any statement describing an unannounced corporate event at a covered issuer, such as the gain or loss of a material contract, a pending transaction, litigation, or a regulatory action, where the expert indicates the information is confidential or not yet announced.",
        "kind": "duty",
        "plain_meaning": "Compliance must review a statement about an unannounced corporate event at a covered issuer when the expert signals it is confidential or not yet announced.",
        "cross_refs": [
          "P7"
        ],
        "ambiguity": null
      },
      {
        "clause_id": "C5",
        "paragraph": "P5",
        "verbatim": "Experts who were employed by a covered issuer within the last twelve months may not discuss that issuer's current-period operating results.",
        "kind": "prohibition",
        "plain_meaning": "An expert who left a covered issuer within twelve months may not discuss its current-period operating results.",
        "cross_refs": [
          "P6",
          "P7"
        ],
        "ambiguity": null
      },
      {
        "clause_id": "C6",
        "paragraph": "P5",
        "verbatim": "Any such statement requires compliance review",
        "kind": "duty",
        "plain_meaning": "A statement that breaks the twelve-month restriction must be reviewed by compliance.",
        "cross_refs": [],
        "ambiguity": null
      },
      {
        "clause_id": "C7",
        "paragraph": "P5",
        "verbatim": "unless the information has been publicly disclosed and compliance verifies the public source",
        "kind": "exception",
        "plain_meaning": "No review under this paragraph when the information is already public and compliance has verified the public source.",
        "cross_refs": [],
        "ambiguity": null
      },
      {
        "clause_id": "C8",
        "paragraph": "P6",
        "verbatim": "Observations that concern the industry as a whole or an aggregated sample of companies, and do not identify a specific covered issuer, are permitted and do not require review on that basis alone.",
        "kind": "exception",
        "plain_meaning": "Industry-wide or aggregated-sample observations that do not identify a covered issuer need no review on that basis alone.",
        "cross_refs": [
          "P2",
          "P5"
        ],
        "ambiguity": null
      },
      {
        "clause_id": "C9",
        "paragraph": "P7",
        "verbatim": "Where a statement may fall under paragraphs 2 through 5 but the company, time period, or source of the information is unclear, compliance must seek clarification before reaching a conclusion.",
        "kind": "evidence_requirement",
        "plain_meaning": "When the company, period, or source is unclear for a statement that may fall under paragraphs 2–5, compliance must ask for clarification before concluding.",
        "cross_refs": [
          "P2",
          "P3",
          "P4",
          "P5"
        ],
        "ambiguity": null
      },
      {
        "clause_id": "C10",
        "paragraph": "P8",
        "verbatim": "Analysts may not hold more than three calls with the same expert in a calendar quarter.",
        "kind": "prohibition",
        "plain_meaning": "An analyst may hold at most three calls with the same expert per calendar quarter.",
        "cross_refs": [],
        "ambiguity": null
      },
      {
        "clause_id": "C11",
        "paragraph": "P9",
        "verbatim": "Compliance retains discretion to review any portion of a call and must document the basis for each decision.",
        "kind": "discretion",
        "plain_meaning": "Compliance may review any part of a call and must document the basis for each decision.",
        "cross_refs": [],
        "ambiguity": null
      }
    ]
  },
