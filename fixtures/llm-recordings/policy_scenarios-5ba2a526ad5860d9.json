erating results AND the statement covers a period the issuer has not yet reported AND NOT (the information matches a verified public source)\",\n  \"predicate_keys\": [\n    \"expert_recent_issuer_employee(months=12)\",\n    \"about_covered_issuer\",\n    \"company_specific_operating_metric\",\n    \"current_or_unreported_period\",\n    \"public_match_verified\"\n  ],\n  \"on_true\": \"open_review\",\n  \"on_indeterminate\": \"open_context_task\"\n}\n</rules>\n\nWrite the scenarios.",
